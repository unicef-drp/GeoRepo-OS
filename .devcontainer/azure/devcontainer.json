{
    "name": "Azure Env",
    "remoteUser": "root",
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "dockerComposeFile": [
      "../../deployment/docker-compose.yml",
      "../../deployment/docker-compose.azure.override.devcontainer.yml"
    ],
    "service": "dev",
    "runServices": ["db", "redis", "celery_beat", "worker", "dev", "azurite"],
    "workspaceFolder": "/home/web/project",
    "portsAttributes": {
      "9000": {
        "label": "Frontend",
        "onAutoForward": "notify"
      }
    },
    "mounts": [
      "source=${localWorkspaceFolder}/.claude_vscode,target=/home/web/.claude,type=bind,consistency=cached"
    ],
    "remoteEnv": {
      "CLAUDE_CONFIG_DIR": "/home/web/.claude"
    },
    "forwardPorts": [8000, 9000, 51102],
    "shutdownAction": "stopCompose",
    "customizations": {
      "vscode": {
        "extensions": ["ms-python.python", "ms-python.pylance", "ms-azuretools.vscode-docker", "anthropic.claude-code"],
        "settings": {
          "terminal.integrated.shell.linux": "/bin/bash",
          "python.defaultInterpreterPath": "/usr/local/bin/python"
        }
      }
    }
  }
  